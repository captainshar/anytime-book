// Cloudflare Workers config: serve the static Astro build from dist/.
// Cloudflare's build settings run `npm run build` before deploying.
{
	"name": "anytime-book",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	// Required by `wrangler preview`, which builds a preview for each PR branch.
	"previews": {}
}
